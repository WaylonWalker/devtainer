{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "build",
  "subagent_depth": 1,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.4-mini-fast": {
          "options": {
            "textVerbosity": "low"
          },
          "variants": {
            "cheap": {
              "reasoningEffort": "none",
              "textVerbosity": "low"
            }
          }
        },
        "gpt-5.4-mini": {
          "options": {
            "textVerbosity": "low"
          },
          "variants": {
            "cheap": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            }
          }
        },
        "gpt-5.4": {
          "variants": {
            "deep": {
              "reasoningEffort": "medium",
              "textVerbosity": "low"
            }
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "hhao/qwen2.5-coder-tools:7b": {
          "name": "Qwen 2.5 Coder Tools 7B"
        },
        "gemma4:e2b": {
          "name": "Gemma 4 E2B"
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna"
    },
    "plan": {
      "model": "openai/gpt-5.6-luna"
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "local": {
      "disable": true
    },
    "local-gemma": {
      "disable": true
    },
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "summary": {
      "model": "openai/gpt-5.6-luna"
    },
    // "compaction": {
    //   "model": "openai/gpt-5.4-mini-fast"
    // },
    "deep-thinker": {
      "disable": true
    }
  },
  "mcp": {
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
        "--repository",
        "."
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "permission": {
    // "edit": "ask",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    },
    "bash": {
      "ls*": "allow",
      "tree*": "allow",
      "pwd": "allow",
      "stat*": "allow",
      "du*": "allow",
      "df*": "allow",
      "just": "allow",
      "ruff": "allow",
      "ty": "allow",
      "uv run ruff": "allow",
      "uv run ty": "allow",
      // file content inspection
      "cat*": "allow",
      "less*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "sed -n*": "allow",
      "awk*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      // git read-only
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      // kubernetes read-only
      "kubectl get*": "allow",
      "kubectl describe*": "allow",
      "kubectl logs*": "allow",
      "kubectl config get-contexts*": "allow",
      "kubectl config current-context": "allow"
      // default safety net
      // "*": "ask"
    }
  }
}
