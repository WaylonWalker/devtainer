#!/usr/bin/env bash

# Set up an already-cloned Ubuntu GNOME checkout for the current user.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./bootstrap [--dry-run] [--help]

Run from an Ubuntu GNOME login as your normal user (not with sudo).
Install missing desktop dependencies, Podman (including docker compatibility),
and Ghostty, safely stow git zsh tmux
nvim bin gnome ghostty herdr mise wallpaper, apply the repo's GNOME settings,
install mise if needed, and install configured mise tools and JetBrainsMono
Nerd Font. Re-run after signing out and back in if the GNOME extensions are
not yet discoverable.

  -n, --dry-run  Show planned commands without changing anything.
  -h, --help     Show this help.

Exit codes: 0 success, 1 setup/environment error, 2 invalid arguments.
EOF
}

die() {
    printf 'bootstrap: %s\n' "$1" >&2
    exit "${2:-1}"
}

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

has_subid_range() {
    local user="$1" file="$2"
    [[ -r "$file" ]] || die "Cannot read $file; ask your administrator to configure rootless Podman."
    awk -F: -v user="$user" '
        $1 == user && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 >= 65536 { found=1 }
        END { exit !found }
    ' "$file"
}

free_subid_range() {
    awk -F: '
        NF >= 3 && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 > 0 {
            first[++n]=$2; last[n]=$2+$3-1
        }
        END {
            for (start=100000; start<=4294901759; start+=65536) {
                end=start+65535
                for (i=1; i<=n; i++)
                    if (start<=last[i] && end>=first[i]) break
                if (i>n) {
                    printf "%.0f-%.0f\n", start, end
                    exit
                }
            }
            exit 1
        }
    ' "$@"
}

dry_run=false
while (($#)); do
    case "$1" in
        -n|--dry-run) dry_run=true ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unknown argument: $1 (see --help)" 2 ;;
    esac
    shift
done

repo_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
packages=(git stow zsh tmux jq fzf rofi ffmpeg python3 curl fontconfig snapd
          podman podman-docker uidmap slirp4netns fuse-overlayfs
          gnome-shell libglib2.0-bin gnome-shell-extension-ubuntu-tiling-assistant
          yaru-theme-gtk yaru-theme-icon)
stow_packages=(git zsh tmux nvim bin gnome ghostty herdr mise wallpaper)
herdr_plugins=(last-workspace scratch-workspace)
gnome_script="$repo_dir/gnome/.local/bin/devtainer-gnome-bootstrap"
font_script="$repo_dir/scripts/install-jetbrainsmono-nerd-font"
[[ -f "$gnome_script" ]] || die "GNOME bootstrap missing: $gnome_script"
[[ -f "$font_script" ]] || die "Font installer missing: $font_script"
for package in "${stow_packages[@]}"; do
    [[ -d "$repo_dir/$package" ]] || die "Stow package missing: $repo_dir/$package"
done
for plugin in "${herdr_plugins[@]}"; do
    [[ -f "$repo_dir/herdr/.config/herdr/plugins/$plugin/herdr-plugin.toml" ]] ||
        die "Herdr plugin missing: $repo_dir/herdr/.config/herdr/plugins/$plugin"
done

stow_args=(--no-folding -R -d "$repo_dir" -t "$HOME" "${stow_packages[@]}")

command -v dpkg-query >/dev/null 2>&1 ||
    die "Missing dpkg-query; this bootstrap requires an Ubuntu system."
missing_packages=()
for package in "${packages[@]}"; do
    case "$package" in
        ffmpeg) command -v ffplay >/dev/null 2>&1 && continue ;;
    esac
    status="$(dpkg-query -W -f='${Status}' -- "$package" 2>/dev/null)" || status=""
    [[ "$status" == "install ok installed" ]] || missing_packages+=("$package")
done
ghostty_installed=false
if command -v snap >/dev/null 2>&1 && snap list ghostty >/dev/null 2>&1; then
    ghostty_installed=true
fi
user="$(id -un)"
subuids_missing=false
subgids_missing=false
has_subid_range "$user" /etc/subuid || subuids_missing=true
has_subid_range "$user" /etc/subgid || subgids_missing=true
if [[ "$subuids_missing" == true || "$subgids_missing" == true ]]; then
    subid_range="$(free_subid_range /etc/subuid /etc/subgid)" ||
        die "No free subordinate ID range found; ask your administrator to configure /etc/subuid and /etc/subgid."
fi

if [[ "$dry_run" == true ]]; then
    echo "Dry run: no apt, snap, user IDs, services, stow, or GNOME settings will be changed."
    if (( ${#missing_packages[@]} )); then
        print_command sudo apt update
        print_command sudo apt install -y "${missing_packages[@]}"
    else
        echo "Required apt packages are already installed; no apt install needed."
    fi
    if [[ "$ghostty_installed" == false ]]; then
        print_command sudo snap install ghostty --classic
    fi
    if [[ "$subuids_missing" == true ]]; then
        print_command sudo usermod --add-subuids "$subid_range" "$user"
    fi
    if [[ "$subgids_missing" == true ]]; then
        print_command sudo usermod --add-subgids "$subid_range" "$user"
    fi
    if ! systemctl --user is-enabled --quiet podman.socket 2>/dev/null ||
       ! systemctl --user is-active --quiet podman.socket 2>/dev/null; then
        print_command systemctl --user enable --now podman.socket
    fi
    print_command stow --simulate "${stow_args[@]}"
    print_command stow "${stow_args[@]}"
    print_command bash "$gnome_script"
    if command -v mise >/dev/null 2>&1; then
        mise_bin="$(command -v mise)"
    else
        mise_bin="$HOME/.local/bin/mise"
        [[ -x "$mise_bin" ]] || echo '+ curl -fsSL https://mise.run | sh'
    fi
    print_command "$mise_bin" -C "$HOME" install
    for plugin in "${herdr_plugins[@]}"; do
        print_command "$mise_bin" -C "$HOME" exec -- herdr plugin link \
            "$repo_dir/herdr/.config/herdr/plugins/$plugin" --enabled
    done
    print_command bash "$font_script"
    echo "Preview only: GNOME Shell compatibility and stow conflicts are not checked in dry-run."
    echo "On a real run, unsupported GNOME versions and stow conflicts stop setup."
    exit 0
fi

(( EUID != 0 )) || die "Run as your GNOME user, not root; sudo is used only for system setup."
[[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] ||
    die "Run inside an active GNOME desktop login (XDG_CURRENT_DESKTOP must include GNOME)."
[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] ||
    die "No session bus found; run inside your active GNOME desktop login."
for command in gnome-shell gsettings; do
    command -v "$command" >/dev/null 2>&1 || die "Missing command: $command"
done
version="$(gnome-shell --version)" || die "Cannot determine GNOME Shell version."
if [[ "$version" =~ GNOME[[:space:]]Shell[[:space:]]([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
else
    die "Cannot parse GNOME Shell version: $version (supported: 45-48)."
fi
(( major >= 45 && major <= 48 )) ||
    die "GNOME Shell $major is unsupported by the bundled extensions (supported: 45-48)."
[[ "$(gsettings writable org.gnome.desktop.interface clock-format)" == true ]] ||
    die "GNOME settings are not writable; run inside your active GNOME login."

if (( ${#missing_packages[@]} )); then
    for command in sudo apt; do
        command -v "$command" >/dev/null 2>&1 || die "Missing command: $command"
    done
    echo "Installing missing Ubuntu desktop dependencies: ${missing_packages[*]}"
    sudo apt update ||
        die "Package list update failed. Check your sudo permissions and apt configuration."
    sudo apt install -y "${missing_packages[@]}" ||
        die "Package installation failed or is not permitted: ${missing_packages[*]}. Check sudo -l or ask your administrator."
else
    echo "Required apt packages are already installed; skipping sudo."
fi

if [[ "$subuids_missing" == true || "$subgids_missing" == true ]]; then
    command -v sudo >/dev/null 2>&1 || die "Missing sudo; subordinate IDs require administrator access."
    if [[ "$subuids_missing" == true ]]; then
        sudo usermod --add-subuids "$subid_range" "$user" ||
            die "Could not assign subordinate UIDs to $user; ask your administrator to configure /etc/subuid."
    fi
    if [[ "$subgids_missing" == true ]]; then
        sudo usermod --add-subgids "$subid_range" "$user" ||
            die "Could not assign subordinate GIDs to $user; ask your administrator to configure /etc/subgid."
    fi
fi
if ! systemctl --user is-enabled --quiet podman.socket ||
   ! systemctl --user is-active --quiet podman.socket; then
    echo "Enabling the rootless Podman socket for $user..."
    systemctl --user enable --now podman.socket ||
        die "Could not start the user Podman socket; check your user systemd session."
fi

if [[ "$ghostty_installed" == false ]]; then
    for command in sudo snap; do
        command -v "$command" >/dev/null 2>&1 || die "Missing command: $command"
    done
    echo "Installing Ghostty from Snap..."
    sudo snap install ghostty --classic ||
        die "Ghostty installation failed; check snapd, network access, and sudo permissions, then re-run ./bootstrap."
fi

echo "Checking stow links for conflicts..."
if ! stow --simulate "${stow_args[@]}"; then
    die "Stow found conflicts. Move or back up conflicting files yourself and re-run; nothing was adopted or overwritten."
fi
stow "${stow_args[@]}"

echo "Applying GNOME settings as $(id -un)..."
bash "$gnome_script" || die "GNOME setup failed; resolve the error above and re-run ./bootstrap."
if command -v mise >/dev/null 2>&1; then
    mise_bin="$(command -v mise)"
else
    mise_bin="$HOME/.local/bin/mise"
    if [[ ! -x "$mise_bin" ]]; then
        command -v curl >/dev/null 2>&1 ||
            die "Missing curl; install it before installing mise."
        echo "Installing mise via https://mise.run..."
        curl -fsSL https://mise.run | sh ||
            die "Mise installation failed; check network access to https://mise.run and re-run ./bootstrap."
        [[ -x "$mise_bin" ]] ||
            die "Mise installer did not create an executable at $mise_bin."
    fi
fi
echo "Installing global mise tools..."
"$mise_bin" -C "$HOME" install ||
    die "Mise tool installation failed; resolve the error above and re-run ./bootstrap."
echo "Registering bundled Herdr plugins..."
for plugin in "${herdr_plugins[@]}"; do
    "$mise_bin" -C "$HOME" exec -- herdr plugin link \
        "$repo_dir/herdr/.config/herdr/plugins/$plugin" --enabled ||
        die "Herdr plugin registration failed for $plugin; resolve the error above and re-run ./bootstrap."
done
echo "Installing JetBrainsMono Nerd Font..."
bash "$font_script" ||
    die "JetBrainsMono Nerd Font installation failed; resolve the error above and re-run ./bootstrap."
echo "Done. If newly installed extensions are not discovered, sign out and back in, then re-run ./bootstrap."
