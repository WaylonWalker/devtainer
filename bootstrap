#!/usr/bin/env bash

# Set up an already-cloned Ubuntu GNOME checkout for the current user.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./bootstrap [--dry-run] [--help]

Run from an Ubuntu GNOME login as your normal user (not with sudo).
Install missing desktop dependencies, safely stow git zsh tmux nvim bin gnome
herdr mise wallpaper, apply the repo's GNOME settings, install mise if needed,
and install configured mise tools and JetBrainsMono Nerd Font. Re-run after
signing out and back in if the GNOME extensions are not yet discoverable.

  -n, --dry-run  Show planned commands without changing anything.
  -h, --help     Show this help.

Exit codes: 0 success, 1 setup/environment error, 2 invalid arguments.
EOF
}

die() {
    printf 'bootstrap: %s\n' "$1" >&2
    exit "${2:-1}"
}

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

dry_run=false
while (($#)); do
    case "$1" in
        -n|--dry-run) dry_run=true ;;
        -h|--help) usage; exit 0 ;;
        *) die "Unknown argument: $1 (see --help)" 2 ;;
    esac
    shift
done

repo_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
packages=(git stow zsh tmux jq fzf rofi ffmpeg python3 curl fontconfig
          gnome-shell libglib2.0-bin gnome-shell-extension-ubuntu-tiling-assistant
          yaru-theme-gtk yaru-theme-icon)
stow_packages=(git zsh tmux nvim bin gnome herdr mise wallpaper)
gnome_script="$repo_dir/gnome/.local/bin/devtainer-gnome-bootstrap"
font_script="$repo_dir/scripts/install-jetbrainsmono-nerd-font"
[[ -f "$gnome_script" ]] || die "GNOME bootstrap missing: $gnome_script"
[[ -f "$font_script" ]] || die "Font installer missing: $font_script"
for package in "${stow_packages[@]}"; do
    [[ -d "$repo_dir/$package" ]] || die "Stow package missing: $repo_dir/$package"
done

stow_args=(--no-folding -R -d "$repo_dir" -t "$HOME" "${stow_packages[@]}")

command -v dpkg-query >/dev/null 2>&1 ||
    die "Missing dpkg-query; this bootstrap requires an Ubuntu system."
missing_packages=()
for package in "${packages[@]}"; do
    case "$package" in
        ffmpeg) command -v ffplay >/dev/null 2>&1 && continue ;;
    esac
    status="$(dpkg-query -W -f='${Status}' -- "$package" 2>/dev/null)" || status=""
    [[ "$status" == "install ok installed" ]] || missing_packages+=("$package")
done

if [[ "$dry_run" == true ]]; then
    echo "Dry run: no apt, stow, or GNOME settings will be changed."
    if (( ${#missing_packages[@]} )); then
        print_command sudo apt update
        print_command sudo apt install -y "${missing_packages[@]}"
    else
        echo "Required apt packages are already installed; no sudo needed."
    fi
    print_command stow --simulate "${stow_args[@]}"
    print_command stow "${stow_args[@]}"
    print_command bash "$gnome_script"
    if command -v mise >/dev/null 2>&1; then
        mise_bin="$(command -v mise)"
    else
        mise_bin="$HOME/.local/bin/mise"
        [[ -x "$mise_bin" ]] || echo '+ curl -fsSL https://mise.run | sh'
    fi
    print_command "$mise_bin" -C "$HOME" install
    print_command bash "$font_script"
    echo "Preview only: GNOME Shell compatibility and stow conflicts are not checked in dry-run."
    echo "On a real run, unsupported GNOME versions and stow conflicts stop setup."
    exit 0
fi

(( EUID != 0 )) || die "Run as your GNOME user, not root; sudo is used only for apt."
[[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] ||
    die "Run inside an active GNOME desktop login (XDG_CURRENT_DESKTOP must include GNOME)."
[[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] ||
    die "No session bus found; run inside your active GNOME desktop login."
for command in gnome-shell gsettings; do
    command -v "$command" >/dev/null 2>&1 || die "Missing command: $command"
done
version="$(gnome-shell --version)" || die "Cannot determine GNOME Shell version."
if [[ "$version" =~ GNOME[[:space:]]Shell[[:space:]]([0-9]+) ]]; then
    major="${BASH_REMATCH[1]}"
else
    die "Cannot parse GNOME Shell version: $version (supported: 45-48)."
fi
(( major >= 45 && major <= 48 )) ||
    die "GNOME Shell $major is unsupported by the bundled extensions (supported: 45-48)."
[[ "$(gsettings writable org.gnome.desktop.interface clock-format)" == true ]] ||
    die "GNOME settings are not writable; run inside your active GNOME login."

if (( ${#missing_packages[@]} )); then
    for command in sudo apt; do
        command -v "$command" >/dev/null 2>&1 || die "Missing command: $command"
    done
    echo "Installing missing Ubuntu desktop dependencies: ${missing_packages[*]}"
    sudo apt update ||
        die "Package list update failed. Check your sudo permissions and apt configuration."
    sudo apt install -y "${missing_packages[@]}" ||
        die "Package installation failed or is not permitted: ${missing_packages[*]}. Check sudo -l or ask your administrator."
else
    echo "Required apt packages are already installed; skipping sudo."
fi

echo "Checking stow links for conflicts..."
if ! stow --simulate "${stow_args[@]}"; then
    die "Stow found conflicts. Move or back up conflicting files yourself and re-run; nothing was adopted or overwritten."
fi
stow "${stow_args[@]}"

echo "Applying GNOME settings as $(id -un)..."
bash "$gnome_script" || die "GNOME setup failed; resolve the error above and re-run ./bootstrap."
if command -v mise >/dev/null 2>&1; then
    mise_bin="$(command -v mise)"
else
    mise_bin="$HOME/.local/bin/mise"
    if [[ ! -x "$mise_bin" ]]; then
        command -v curl >/dev/null 2>&1 ||
            die "Missing curl; install it before installing mise."
        echo "Installing mise via https://mise.run..."
        curl -fsSL https://mise.run | sh ||
            die "Mise installation failed; check network access to https://mise.run and re-run ./bootstrap."
        [[ -x "$mise_bin" ]] ||
            die "Mise installer did not create an executable at $mise_bin."
    fi
fi
echo "Installing global mise tools..."
"$mise_bin" -C "$HOME" install ||
    die "Mise tool installation failed; resolve the error above and re-run ./bootstrap."
echo "Installing JetBrainsMono Nerd Font..."
bash "$font_script" ||
    die "JetBrainsMono Nerd Font installation failed; resolve the error above and re-run ./bootstrap."
echo "Done. If newly installed extensions are not discovered, sign out and back in, then re-run ./bootstrap."
