#!/usr/bin/env bash

set -euo pipefail

theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/devtainer-rofi.rasi"

exec rofi \
    -show window \
    -show-icons \
    -icon-theme Qogir \
    -theme "$theme" \
    -i \
    -matching fuzzy \
    -sorting-method fzf \
    -sort \
    -display-window "windows"
