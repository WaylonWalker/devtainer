#!/usr/bin/env bash

# Apply the repo's GNOME defaults into the current login session.

set -euo pipefail

DRY_RUN=false
VERBOSE=false
LOCAL_BIN="${HOME}/.local/bin"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/devtainer/gnome-awesome.conf"
MONITOR_SWAP_EXTENSION_UUID="devtainer-monitor-swap@waylonwalker.com"
MONITOR_SWAP_EXTENSION_DIR="${HOME}/.local/share/gnome-shell/extensions/${MONITOR_SWAP_EXTENSION_UUID}"
MONITOR_SWAP_EXTENSION_SCHEMA="org.gnome.shell.extensions.devtainer-monitor-swap"
WORKSPACE_FOCUS_EXTENSION_UUID="devtainer-workspace-focus@waylonwalker.com"
WORKSPACE_FOCUS_EXTENSION_DIR="${HOME}/.local/share/gnome-shell/extensions/${WORKSPACE_FOCUS_EXTENSION_UUID}"
WORKSPACE_FOCUS_EXTENSION_SCHEMA="org.gnome.shell.extensions.devtainer-workspace-focus"
CONFIG_FILE_EXPLICIT=false

usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Apply the repo's GNOME defaults and keybindings.

Options:
  -c, --config PATH  Read settings from PATH instead of the default config file.
  -n, --dry-run      Print the changes that would be applied without mutating GNOME.
  -v, --verbose      Print each mutating command before it runs.
  -h, --help         Show this help text.

Default config:
  ${CONFIG_FILE}

Exit codes:
  0  success
  1  runtime or environment error
  2  invalid command-line usage
EOF
}

die() {
    echo "$1" >&2
    exit "${2:-1}"
}

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

run() {
    if [[ "$VERBOSE" == "true" || "$DRY_RUN" == "true" ]]; then
        print_command "$@"
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        return 0
    fi

    "$@"
}

while (($#)); do
    case "$1" in
        -c|--config)
            shift
            [[ $# -gt 0 ]] || die "Missing value for --config" 2
            CONFIG_FILE="$1"
            CONFIG_FILE_EXPLICIT=true
            ;;
        --config=*)
            CONFIG_FILE="${1#*=}"
            CONFIG_FILE_EXPLICIT=true
            ;;
        -n|--dry-run)
            DRY_RUN=true
            ;;
        -v|--verbose)
            VERBOSE=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            [[ $# -eq 0 ]] || die "Unexpected positional arguments: $*" 2
            break
            ;;
        *)
            die "Unknown option: $1" 2
            ;;
    esac
    shift
done

BOOTSTRAP_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
BOOTSTRAP_DIR="$(dirname "$BOOTSTRAP_SOURCE")"
MONITOR_SWAP_EXTENSION_SOURCE_DIR="${BOOTSTRAP_DIR}/../share/gnome-shell/extensions/${MONITOR_SWAP_EXTENSION_UUID}"
WORKSPACE_FOCUS_EXTENSION_SOURCE_DIR="${BOOTSTRAP_DIR}/../share/gnome-shell/extensions/${WORKSPACE_FOCUS_EXTENSION_UUID}"

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
elif [[ "$CONFIG_FILE_EXPLICIT" == "true" ]]; then
    die "Config file not found: $CONFIG_FILE"
fi

WORKSPACE_COUNT="${WORKSPACE_COUNT:-9}"
WORKSPACES_ONLY_ON_PRIMARY="${WORKSPACES_ONLY_ON_PRIMARY:-true}"
PRESERVE_WORKSPACE_MONITOR_FOCUS="${PRESERVE_WORKSPACE_MONITOR_FOCUS:-true}"
MONITOR_SWAP_BACK_BINDING="${MONITOR_SWAP_BACK_BINDING:-<Super><Shift>o}"
CLOCK_FORMAT="${CLOCK_FORMAT:-12h}"
DISABLE_UBUNTU_DOCK="${DISABLE_UBUNTU_DOCK:-true}"
SCREENSHOT_BINDING="${SCREENSHOT_BINDING:-<Super><Alt>p}"
SCREENSHOT_COMMAND="${SCREENSHOT_COMMAND:-${LOCAL_BIN}/devtainer-gnome-screenshot-area}"
FFPLAY_CAMERA_BINDING="${FFPLAY_CAMERA_BINDING:-<Super>s}"
RECORD_AREA_BINDING="${RECORD_AREA_BINDING:-<Super><Shift>s}"
CUSTOM_KEYBINDING_PATH="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-rectangle-screenshot/"
CUSTOM_KEYBINDING_SCHEMA="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${CUSTOM_KEYBINDING_PATH}"

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Missing required command: $1" >&2
        exit 1
    fi
}

clear_gsettings_string_array() {
    local schema="$1"
    local key="$2"

    run gsettings set "$schema" "$key" "[]"
}

quote_gvariant_string() {
    printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\"'\"'/g")"
}

set_gsettings_string() {
    local schema="$1"
    local key="$2"
    local value="$3"

    run gsettings set "$schema" "$key" "$(quote_gvariant_string "$value")"
}

merge_gsettings_string_array() {
    local schema="$1"
    local key="$2"
    shift 2

    local existing
    existing="$(gsettings get "$schema" "$key")"

    run gsettings set "$schema" "$key" "$(
        python3 - "$existing" "$@" <<'PY'
import ast
import sys

raw = sys.argv[1].strip()
if raw.startswith("@as "):
    raw = raw[4:]

items = list(ast.literal_eval(raw))
for value in sys.argv[2:]:
    if value not in items:
        items.append(value)

print("[" + ", ".join(repr(item) for item in items) + "]")
PY
    )"
}

sync_gsettings_string_array() {
    local schema="$1"
    local key="$2"
    local desired="$3"
    shift 3

    local existing
    existing="$(gsettings get "$schema" "$key")"

    run gsettings set "$schema" "$key" "$(
        python3 - "$existing" "$desired" "$@" <<'PY'
import ast
import sys

raw = sys.argv[1].strip()
if raw.startswith("@as "):
    raw = raw[4:]

items = list(ast.literal_eval(raw))
desired = sys.argv[2]
managed = set(sys.argv[3:])

items = [item for item in items if item not in managed]
if desired not in items:
    items.append(desired)

print("[" + ", ".join(repr(item) for item in items) + "]")
PY
    )"
}

set_gsettings_string_array() {
    local schema="$1"
    local key="$2"
    shift 2

    local values=()
    local value

    for value in "$@"; do
        values+=("$(quote_gvariant_string "$value")")
    done

    local joined
    joined=$(IFS=,; printf "%s" "${values[*]}")
    run gsettings set "$schema" "$key" "[$joined]"
}

set_extension_gsettings_string_array() {
    local schema_dir="$1"
    local schema="$2"
    local key="$3"
    shift 3

    local values=()
    local value

    for value in "$@"; do
        values+=("$(quote_gvariant_string "$value")")
    done

    local joined
    joined=$(IFS=,; printf "%s" "${values[*]}")
    run gsettings --schemadir "$schema_dir" set "$schema" "$key" "[$joined]"
}

clear_extension_gsettings_string_array() {
    local schema_dir="$1"
    local schema="$2"
    local key="$3"

    run gsettings --schemadir "$schema_dir" set "$schema" "$key" "[]"
}

install_extension() {
    local source_dir="$1"
    local uuid="$2"
    local source_schema
    local schema_args=()
    local temporary_dir
    local extension_bundle

    [[ -f "$source_dir/extension.js" && -f "$source_dir/metadata.json" ]] ||
        die "Extension source is incomplete: $source_dir"

    for source_schema in "$source_dir"/schemas/*.gschema.xml; do
        [[ -f "$source_schema" ]] || continue
        schema_args+=(--schema "${source_schema#"$source_dir"/}")
    done

    # GNOME Shell does not discover Stow's symbolic links. Installing a bundle
    # copies the extension into its managed directory and refreshes discovery.
    if [[ "$DRY_RUN" == "true" ]]; then
        print_command gnome-extensions pack --force --out-dir "<temporary-directory>" "${schema_args[@]}" "$source_dir"
        print_command gnome-extensions install --force "<temporary-directory>/${uuid}.shell-extension.zip"
        return
    fi

    temporary_dir="$(mktemp -d)"
    extension_bundle="${temporary_dir}/${uuid}.shell-extension.zip"
    run gnome-extensions pack --force --out-dir "$temporary_dir" "${schema_args[@]}" "$source_dir"
    run gnome-extensions install --force "$extension_bundle"
    rm -f "$extension_bundle"
    rmdir "$temporary_dir"
}

enable_extension_when_discovered() {
    local uuid="$1"

    if gnome-extensions info "$uuid" >/dev/null 2>&1; then
        run gnome-extensions enable "$uuid"
    else
        echo "Installed $uuid. Sign out and back in, then rerun this bootstrap to enable it." >&2
    fi
}

upsert_custom_keybinding() {
    local path="$1"
    local name="$2"
    local command="$3"
    local binding="$4"
    local schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:${path}"

    merge_gsettings_string_array \
        org.gnome.settings-daemon.plugins.media-keys \
        custom-keybindings \
        "$path"

    set_gsettings_string "$schema" name "$name"
    set_gsettings_string "$schema" command "$command"
    set_gsettings_string "$schema" binding "$binding"
}

remove_custom_keybinding() {
    local path="$1"
    local existing

    existing="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings)"

    run gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$(
        python3 - "$existing" "$path" <<'PY'
import ast
import sys

raw = sys.argv[1].strip()
if raw.startswith("@as "):
    raw = raw[4:]

path = sys.argv[2]
items = [item for item in ast.literal_eval(raw) if item != path]
print("[" + ", ".join(repr(item) for item in items) + "]")
PY
    )"
}

require_command gsettings
require_command python3
require_command glib-compile-schemas
require_command gnome-extensions

if [[ "$(gsettings writable org.gnome.desktop.interface clock-format)" != "true" ]]; then
    echo "GNOME settings are not writable from this session. Run this inside an active GNOME login." >&2
    exit 1
fi

if (( WORKSPACE_COUNT < 1 )); then
    echo "WORKSPACE_COUNT must be at least 1, got: $WORKSPACE_COUNT" >&2
    exit 1
fi

if [[ "$PRESERVE_WORKSPACE_MONITOR_FOCUS" != "true" && "$PRESERVE_WORKSPACE_MONITOR_FOCUS" != "false" ]]; then
    echo "PRESERVE_WORKSPACE_MONITOR_FOCUS must be true or false, got: $PRESERVE_WORKSPACE_MONITOR_FOCUS" >&2
    exit 1
fi

WORKSPACE_FOCUS_EXTENSION_AVAILABLE=false
if [[ "$PRESERVE_WORKSPACE_MONITOR_FOCUS" == "true" ]] &&
    gnome-extensions info "$WORKSPACE_FOCUS_EXTENSION_UUID" >/dev/null 2>&1; then
    WORKSPACE_FOCUS_EXTENSION_AVAILABLE=true
fi

MONITOR_SWAP_EXTENSION_AVAILABLE=false
if gnome-extensions info "$MONITOR_SWAP_EXTENSION_UUID" >/dev/null 2>&1; then
    MONITOR_SWAP_EXTENSION_AVAILABLE=true
fi

run gsettings set org.gnome.mutter dynamic-workspaces false
run gsettings set org.gnome.mutter workspaces-only-on-primary "$WORKSPACES_ONLY_ON_PRIMARY"
run gsettings set org.gnome.desktop.wm.preferences num-workspaces "$WORKSPACE_COUNT"

for workspace in $(seq 1 9); do
    if (( workspace <= WORKSPACE_COUNT )); then
        if [[ "$WORKSPACE_FOCUS_EXTENSION_AVAILABLE" == "true" ]]; then
            clear_gsettings_string_array \
                org.gnome.desktop.wm.keybindings \
                "switch-to-workspace-${workspace}"
        else
            set_gsettings_string_array \
                org.gnome.desktop.wm.keybindings \
                "switch-to-workspace-${workspace}" \
                "<Super>${workspace}"
        fi

        set_gsettings_string_array \
            org.gnome.desktop.wm.keybindings \
            "move-to-workspace-${workspace}" \
            "<Super><Shift>${workspace}"
    else
        clear_gsettings_string_array \
            org.gnome.desktop.wm.keybindings \
            "switch-to-workspace-${workspace}"

        clear_gsettings_string_array \
            org.gnome.desktop.wm.keybindings \
            "move-to-workspace-${workspace}"
    fi
done

for workspace in $(seq 1 9); do
    clear_gsettings_string_array \
        org.gnome.shell.keybindings \
        "switch-to-application-${workspace}"
done

if [[ "$FFPLAY_CAMERA_BINDING" == "<Super>s" ]]; then
    clear_gsettings_string_array \
        org.gnome.shell.keybindings \
        toggle-quick-settings
fi

sync_gsettings_string_array \
    org.gnome.desktop.wm.keybindings \
    switch-windows \
    "${WINDOW_NEXT_BINDING:-<Super>j}" \
    "<Super>j"

sync_gsettings_string_array \
    org.gnome.desktop.wm.keybindings \
    switch-windows-backward \
    "${WINDOW_PREV_BINDING:-<Super>k}" \
    "<Super>k"

sync_gsettings_string_array \
    org.gnome.desktop.wm.keybindings \
    close \
    "${CLOSE_WINDOW_BINDING:-<Super>c}" \
    "<Super>w" \
    "<Super>c"

sync_gsettings_string_array \
    org.gnome.desktop.wm.keybindings \
    toggle-maximized \
    "${TOGGLE_MAXIMIZE_BINDING:-<Super>f}" \
    "<Super>f"

sync_gsettings_string_array \
    org.gnome.settings-daemon.plugins.media-keys \
    rotate-video-lock-static \
    "XF86RotationLockToggle" \
    "<Super>o" \
    "XF86RotationLockToggle"

if [[ "$MONITOR_SWAP_EXTENSION_AVAILABLE" == "true" ]]; then
    sync_gsettings_string_array \
        org.gnome.desktop.wm.keybindings \
        move-to-monitor-left \
        "<Super><Shift>Left" \
        "<Super>o" \
        "<Super><Shift>o" \
        "<Super><Shift>Left"

    sync_gsettings_string_array \
        org.gnome.desktop.wm.keybindings \
        move-to-monitor-right \
        "<Super><Shift>Right" \
        "<Super>o" \
        "<Super><Shift>Right"
else
    sync_gsettings_string_array \
        org.gnome.desktop.wm.keybindings \
        move-to-monitor-left \
        "$MONITOR_SWAP_BACK_BINDING" \
        "<Super>o" \
        "<Super><Shift>o" \
        "<Super><Shift>Left"

    sync_gsettings_string_array \
        org.gnome.desktop.wm.keybindings \
        move-to-monitor-right \
        "${MONITOR_SWAP_BINDING:-<Super>o}" \
        "<Super>o" \
        "<Super><Shift>Right"
fi

if gsettings list-schemas | grep -Fxq "org.gnome.shell.extensions.dash-to-dock"; then
    run gsettings set org.gnome.shell.extensions.dash-to-dock hot-keys false
    run gsettings set org.gnome.shell.extensions.dash-to-dock hotkeys-overlay false

    if [[ "$DISABLE_UBUNTU_DOCK" == "true" ]]; then
        if command -v gnome-extensions >/dev/null 2>&1 && gnome-extensions list | grep -Fxq "ubuntu-dock@ubuntu.com"; then
            run gnome-extensions disable ubuntu-dock@ubuntu.com
        else
            echo "Unable to disable ubuntu-dock@ubuntu.com automatically because gnome-extensions is unavailable." >&2
            exit 1
        fi
    fi
fi

if [[ "${DISABLE_DESKTOP_ICONS:-true}" == "true" ]]; then
    if command -v gnome-extensions >/dev/null 2>&1 && gnome-extensions list | grep -Fxq "ding@rastersoft.com"; then
        run gnome-extensions disable ding@rastersoft.com
    fi

    if gsettings list-schemas | grep -Fxq "org.gnome.shell.extensions.ding"; then
        run gsettings set org.gnome.shell.extensions.ding show-home false
        run gsettings set org.gnome.shell.extensions.ding show-trash false
        run gsettings set org.gnome.shell.extensions.ding show-volumes false
        run gsettings set org.gnome.shell.extensions.ding show-network-volumes false
    fi
fi

set_gsettings_string org.gnome.desktop.interface clock-format "$CLOCK_FORMAT"

upsert_custom_keybinding \
    "$CUSTOM_KEYBINDING_PATH" \
    "Rectangular Screenshot" \
    "$SCREENSHOT_COMMAND" \
    "$SCREENSHOT_BINDING"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-kitty-focus/" \
    "Kitty Focus Or Launch" \
    "${LOCAL_BIN}/devtainer-kitty-focus-or-launch" \
    "${KITTY_FOCUS_BINDING:-<Super>Return}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-kitty-new/" \
    "Kitty New" \
    "${LOCAL_BIN}/devtainer-kitty-new" \
    "${KITTY_NEW_BINDING:-<Super><Shift>Return}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-chrome-focus/" \
    "Chrome Focus Or Launch" \
    "${LOCAL_BIN}/devtainer-chrome-focus-or-launch" \
    "${CHROME_FOCUS_BINDING:-<Super>b}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-chrome-new/" \
    "Chrome New" \
    "${LOCAL_BIN}/devtainer-chrome-new" \
    "${CHROME_NEW_BINDING:-<Super><Shift>b}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-files-focus/" \
    "Files Focus Or Launch" \
    "${LOCAL_BIN}/devtainer-files-focus-or-launch" \
    "${FILES_FOCUS_BINDING:-<Super>e}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-ffplay-camera-toggle/" \
    "FFplay Camera Toggle" \
    "${LOCAL_BIN}/devtainer-ffplay-camera-toggle" \
    "$FFPLAY_CAMERA_BINDING"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-record-area-toggle/" \
    "Rectangular Screen Recording Toggle" \
    "${LOCAL_BIN}/devtainer-gnome-record-area-toggle" \
    "$RECORD_AREA_BINDING"

remove_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-monitor-swap/"

remove_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-monitor-next/"
remove_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-monitor-previous/"

install_extension "$MONITOR_SWAP_EXTENSION_SOURCE_DIR" "$MONITOR_SWAP_EXTENSION_UUID"
run glib-compile-schemas "$MONITOR_SWAP_EXTENSION_DIR/schemas"
set_extension_gsettings_string_array \
    "$MONITOR_SWAP_EXTENSION_DIR/schemas" \
    "$MONITOR_SWAP_EXTENSION_SCHEMA" \
    swap-focused-window-monitor \
    "${MONITOR_SWAP_BINDING:-<Super>o}"
enable_extension_when_discovered "$MONITOR_SWAP_EXTENSION_UUID"

if [[ "$PRESERVE_WORKSPACE_MONITOR_FOCUS" == "true" ]]; then
    install_extension "$WORKSPACE_FOCUS_EXTENSION_SOURCE_DIR" "$WORKSPACE_FOCUS_EXTENSION_UUID"
    run glib-compile-schemas "$WORKSPACE_FOCUS_EXTENSION_DIR/schemas"

    for workspace in $(seq 1 9); do
        if (( workspace <= WORKSPACE_COUNT )); then
            set_extension_gsettings_string_array \
                "$WORKSPACE_FOCUS_EXTENSION_DIR/schemas" \
                "$WORKSPACE_FOCUS_EXTENSION_SCHEMA" \
                "switch-to-workspace-${workspace}" \
                "<Super>${workspace}"
        else
            clear_extension_gsettings_string_array \
                "$WORKSPACE_FOCUS_EXTENSION_DIR/schemas" \
                "$WORKSPACE_FOCUS_EXTENSION_SCHEMA" \
                "switch-to-workspace-${workspace}"
        fi
    done

    enable_extension_when_discovered "$WORKSPACE_FOCUS_EXTENSION_UUID"
elif gnome-extensions list | grep -Fxq "$WORKSPACE_FOCUS_EXTENSION_UUID"; then
    run gnome-extensions disable "$WORKSPACE_FOCUS_EXTENSION_UUID"
fi

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-rofi-window/" \
    "Rofi Window" \
    "${LOCAL_BIN}/devtainer-rofi-window" \
    "${ROFI_WINDOW_BINDING:-<Super>w}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-rofi-run/" \
    "Rofi Run" \
    "${LOCAL_BIN}/devtainer-rofi-run" \
    "${ROFI_RUN_BINDING:-<Super>r}"

upsert_custom_keybinding \
    "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/devtainer-emoji-picker/" \
    "Emoji Picker" \
    "${LOCAL_BIN}/devtainer-emoji-picker" \
    "${EMOJI_PICKER_BINDING:-<Super>semicolon}"
