#!/usr/bin/env bash

set -euo pipefail

theme="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/devtainer-rofi.rasi"

rofi_command() {
    if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] && command -v rofi-wayland >/dev/null 2>&1; then
        printf '%s\n' rofi-wayland
        return
    fi

    printf '%s\n' rofi
}

if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] && ! command -v rofi-wayland >/dev/null 2>&1; then
    exec gdbus call \
        --session \
        --dest org.gnome.Shell \
        --object-path /org/gnome/Shell \
        --method org.gnome.Shell.FocusSearch
fi

exec "$(rofi_command)" \
    -show run \
    -show-icons \
    -icon-theme Qogir \
    -theme "$theme" \
    -i \
    -matching fuzzy \
    -sorting-method fzf \
    -sort \
    -display-run "run"
