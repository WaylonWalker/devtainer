#!/usr/bin/env bash

set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/devtainer/gnome-awesome.conf"
ENV_RECORD_AREA_OUTPUT_DIR="${RECORD_AREA_OUTPUT_DIR-}"
ENV_RECORD_AREA_FRAMERATE="${RECORD_AREA_FRAMERATE-}"
ENV_RECORD_AREA_METADATA_TITLE="${RECORD_AREA_METADATA_TITLE-}"
ENV_RECORD_AREA_GEOMETRY="${RECORD_AREA_GEOMETRY-}"
ENV_RECORD_AREA_AUDIO_SOURCE="${RECORD_AREA_AUDIO_SOURCE-}"

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

RECORD_AREA_OUTPUT_DIR="${ENV_RECORD_AREA_OUTPUT_DIR:-${RECORD_AREA_OUTPUT_DIR:-$HOME/Video/recording}}"
RECORD_AREA_FRAMERATE="${ENV_RECORD_AREA_FRAMERATE:-${RECORD_AREA_FRAMERATE:-30}}"
RECORD_AREA_METADATA_TITLE="${ENV_RECORD_AREA_METADATA_TITLE:-${RECORD_AREA_METADATA_TITLE:-devtainer-gnome-record-area}}"
RECORD_AREA_GEOMETRY="${ENV_RECORD_AREA_GEOMETRY:-${RECORD_AREA_GEOMETRY:-}}"
RECORD_AREA_AUDIO_SOURCE="${ENV_RECORD_AREA_AUDIO_SOURCE:-${RECORD_AREA_AUDIO_SOURCE:-default}}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
PID_FILE="${RUNTIME_DIR}/devtainer-gnome-record-area.pid"
LOG_FILE="${RUNTIME_DIR}/devtainer-gnome-record-area.log"
LAUNCH_LOG_FILE="${RUNTIME_DIR}/devtainer-gnome-record-area-launch.log"

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "Missing required command: $1" >&2
        exit 1
    fi
}

log_launch() {
    printf '%s pid=%s display=%s session=%s geometry=%s\n' \
        "$(date --iso-8601=seconds)" \
        "$$" \
        "${DISPLAY:-}" \
        "${XDG_SESSION_TYPE:-}" \
        "${RECORD_AREA_GEOMETRY:-interactive}" >> "$LAUNCH_LOG_FILE"
}

notify() {
    local summary="$1"
    local body="${2:-}"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send "$summary" "$body" >/dev/null 2>&1 || true
    fi
}

select_screen() {
    require_command xrandr
    local monitors screens selection status
    monitors="$(xrandr --listactivemonitors)" || return 1
    screens="$(python3 - "$monitors" <<'PY'
import re
import sys

found = False
for line in sys.argv[1].splitlines()[1:]:
    fields = line.split()
    if len(fields) < 3:
        continue
    geometry = re.fullmatch(r"(\d+)/\d+x(\d+)/\d+([+-]\d+)([+-]\d+)", fields[2])
    if geometry is None:
        raise SystemExit(f"Invalid monitor geometry: {line}")
    width, height, x, y = map(int, geometry.groups())
    name = fields[1].lstrip("+*")
    print(f"{name} ({width}x{height})\t{x} {y} {width} {height}")
    found = True
if not found:
    raise SystemExit("No active monitors found.")
PY
    )" || return 1

    local -a screen_rows screen_labels
    mapfile -t screen_rows <<<"$screens"
    if [[ "${#screen_rows[@]}" -eq 1 ]]; then
        printf '%s\n' "${screen_rows[0]#*$'\t'}"
        return 0
    fi

    require_command rofi
    local row
    for row in "${screen_rows[@]}"; do
        screen_labels+=("${row%%$'\t'*}")
    done
    if selection="$(printf '%s\n' "${screen_labels[@]}" |
        rofi -dmenu -no-custom -format i -p "Record screen")"; then
        if [[ ! "$selection" =~ ^[0-9]+$ ]] ||
            (( selection >= ${#screen_rows[@]} )); then
            echo "Invalid screen selection: $selection" >&2
            return 1
        fi
        printf '%s\n' "${screen_rows[selection]#*$'\t'}"
    else
        status=$?
        [[ "$status" -eq 1 ]] && return 2
        return 1
    fi
}

is_recording_process() {
    local pid="$1"

    [[ -r "/proc/${pid}/cmdline" ]] || return 1

    local -a argv=()
    mapfile -d '' -t argv < "/proc/${pid}/cmdline"
    [[ "${#argv[@]}" -gt 0 ]] || return 1
    [[ -n "${argv[0]:-}" ]] || return 1
    [[ "${argv[0]##*/}" == "ffmpeg" ]] || return 1

    local saw_metadata=false
    local value
    for value in "${argv[@]}"; do
        if [[ "$value" == "title=${RECORD_AREA_METADATA_TITLE}" ]]; then
            saw_metadata=true
        fi
    done

    [[ "$saw_metadata" == "true" ]]
}

find_recording_pids() {
    local proc_dir

    for proc_dir in /proc/[0-9]*; do
        [[ -r "${proc_dir}/cmdline" ]] || continue

        local pid="${proc_dir##*/}"
        if is_recording_process "$pid"; then
            printf '%s\n' "$pid"
        fi
    done
}

stop_recording() {
    local pid="$1"

    kill -INT "$pid"

    for _ in $(seq 1 50); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            return 0
        fi
        sleep 0.1
    done

    kill -TERM "$pid"
    for _ in $(seq 1 30); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            return 0
        fi
        sleep 0.1
    done

    kill -KILL "$pid"
    for _ in $(seq 1 20); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            return 0
        fi
        sleep 0.1
    done

    echo "Timed out waiting for recording process ${pid} to stop." >&2
    return 1
}

require_command ffmpeg
require_command python3
log_launch

if [[ "${XDG_SESSION_TYPE:-}" != "x11" ]]; then
    echo "Screen recording toggle currently supports GNOME X11 only." >&2
    notify "Screen recording unavailable" "This shortcut currently supports GNOME X11 only."
    exit 1
fi

if [[ -z "${DISPLAY:-}" ]]; then
    echo "DISPLAY is not set, so ffmpeg cannot record the X11 desktop." >&2
    notify "Screen recording unavailable" "DISPLAY is not set for the recorder shortcut."
    exit 1
fi

if [[ -f "$PID_FILE" ]]; then
    existing_pid="$(<"$PID_FILE")"
    if [[ "$existing_pid" =~ ^[0-9]+$ ]] && is_recording_process "$existing_pid"; then
        stop_recording "$existing_pid"
        notify "Screen recording stopped" "Saved under ${RECORD_AREA_OUTPUT_DIR}."
        exit 0
    fi

    rm -f "$PID_FILE"
fi

mapfile -t running_recording_pids < <(find_recording_pids)
if [[ "${#running_recording_pids[@]}" -gt 0 ]]; then
    for existing_pid in "${running_recording_pids[@]}"; do
        stop_recording "$existing_pid"
    done
    notify "Screen recording stopped" "Saved under ${RECORD_AREA_OUTPUT_DIR}."
    exit 0
fi

mkdir -p "$RECORD_AREA_OUTPUT_DIR"
display_target="${DISPLAY}"
if [[ "$display_target" != *.* ]]; then
    display_target="${display_target}.0"
fi

output_file="${RECORD_AREA_OUTPUT_DIR}/recording-$(date +%Y%m%d-%H%M%S).webm"

ffmpeg_input_args=(
    -thread_queue_size 512
    -f x11grab
    -draw_mouse 1
    -framerate "$RECORD_AREA_FRAMERATE"
)

if [[ -n "$RECORD_AREA_GEOMETRY" ]]; then
    read -r x y width height <<<"$RECORD_AREA_GEOMETRY"
else
    if geometry="$(select_screen 2>>"$LAUNCH_LOG_FILE")"; then
        read -r x y width height <<<"$geometry"
    else
        selector_status=$?
        if [[ "$selector_status" -eq 2 ]]; then
            exit 0
        fi
        echo "Recording screen selection failed. Check ${LAUNCH_LOG_FILE}." >&2
        notify "Screen recording failed" "Screen selection failed. Check ${LAUNCH_LOG_FILE}."
        exit 1
    fi
fi

for value in "$x" "$y" "$width" "$height"; do
    if ! [[ "$value" =~ ^-?[0-9]+$ ]]; then
        echo "Invalid recording geometry: ${RECORD_AREA_GEOMETRY:-${x:-} ${y:-} ${width:-} ${height:-}}" >&2
        exit 1
    fi
done

if (( width <= 0 || height <= 0 )); then
    exit 0
fi

ffmpeg_input_args+=(
    -video_size "${width}x${height}"
    -i "${display_target}+${x},${y}"
)

nohup \
    ffmpeg \
    -hide_banner \
    -loglevel error \
    "${ffmpeg_input_args[@]}" \
    -thread_queue_size 512 \
    -f pulse \
    -i "$RECORD_AREA_AUDIO_SOURCE" \
    -map 0:v:0 \
    -map 1:a:0 \
    -c:v libvpx \
    -deadline realtime \
    -cpu-used 8 \
    -threads 8 \
    -b:v 0 \
    -crf 10 \
    -pix_fmt yuv420p \
    -c:a libopus \
    -b:a 128k \
    -af aresample=async=1 \
    -metadata "title=${RECORD_AREA_METADATA_TITLE}" \
    "$output_file" \
    >"$LOG_FILE" 2>&1 < /dev/null &

recording_pid=$!
printf '%s\n' "$recording_pid" > "$PID_FILE"

sleep 0.5
if ! kill -0 "$recording_pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "Screen recording failed to start. Check ${LOG_FILE}." >&2
    notify "Screen recording failed" "Check ${LOG_FILE} for details."
    exit 1
fi

notify "Screen recording started" "$(basename "$output_file")"
